{
  "$id": "https://fogline.dev/schemas/v1/manifest.schema.json",
  "title": "Fogline manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable pack id. Progress is keyed by it."
    },
    "game": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string"
        }
      },
      "required": ["name"]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "description": "BCP 47 language tag"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "Plain string or map of language tag to text"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "description": "BCP 47 language tag"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "Plain string or map of language tag to text"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Version of the pack content"
    },
    "authors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["name"]
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX identifier or \"LicenseRef-Custom\""
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["spdx"],
      "description": "Rights status of the pack content"
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultLanguage": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag"
    },
    "theme": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Color in #RRGGBB form"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Color in #RRGGBB form"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Color in #RRGGBB form"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Color in #RRGGBB form"
            },
            "mapBackdrop": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Color in #RRGGBB form"
            }
          },
          "required": ["accent"],
          "description": "Per-game color palette"
        }
      }
    },
    "maps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Stable identifier"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
                  "description": "BCP 47 language tag"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ],
            "description": "Plain string or map of language tag to text"
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Sort order in the map switcher"
          },
          "size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["width", "height"],
            "description": "Source image size at full resolution"
          },
          "tileSize": {
            "default": 256,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "minZoom": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxZoom": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Native zoom: the image at full resolution"
          },
          "tiles": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "xyz"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Folder holding {z}/{x}/{y}.webp tiles"
                  }
                },
                "required": ["type", "path"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "pmtiles"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Path to a .pmtiles archive"
                  }
                },
                "required": ["type", "path"]
              }
            ],
            "description": "Where the tiles of a map live"
          },
          "thumbnail": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the pack folder, forward slashes"
          },
          "calibration": {
            "description": "Reserved: affine transform from pixels to in-game coordinates",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["id", "name", "order", "size", "minZoom", "maxZoom", "tiles"],
        "description": "One map of the pack"
      }
    },
    "categories": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the category tree file"
    },
    "markers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "description": "Stable identifier"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Path relative to the pack folder, forward slashes"
      },
      "description": "Map id to path of that map’s marker file"
    }
  },
  "required": [
    "formatVersion",
    "id",
    "game",
    "title",
    "version",
    "authors",
    "license",
    "defaultLanguage",
    "maps",
    "categories",
    "markers"
  ],
  "description": "Fogline pack manifest"
}
