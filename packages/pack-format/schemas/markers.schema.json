{
  "$id": "https://fogline.dev/schemas/v1/markers.schema.json",
  "title": "Fogline markers",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "description": "Stable across pack versions; progress depends on it"
      },
      "category": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "description": "A leaf category id"
      },
      "position": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "description": "Position in map pixel space"
      },
      "name": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "description": "BCP 47 language tag"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "description": "Plain string or map of language tag to text"
      },
      "description": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "description": "BCP 47 language tag"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "description": "Plain string or map of language tag to text"
      },
      "attributes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
                    "description": "BCP 47 language tag"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ],
              "description": "Plain string or map of language tag to text"
            },
            "value": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
                        "description": "BCP 47 language tag"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ],
                  "description": "Plain string or map of language tag to text"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "required": [
            "key",
            "label",
            "value"
          ],
          "description": "Generic key/label/value shown in the detail panel"
        }
      },
      "article": {
        "description": "Article id under data/articles/",
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "tags": {
        "description": "Reserved for future facets; ignored in v1",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "id",
      "category",
      "position",
      "name"
    ],
    "description": "One marker on a map"
  },
  "description": "Fogline marker list for one map (data/markers/<mapId>.json)"
}
